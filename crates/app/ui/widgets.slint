// The keyboard focus mark: an accent outline in the control's shape, just outside it
// (`inset`: just inside, for rows that sit edge to edge). Only keyboard focus shows it:
// controls do not take the focus on a click.
export component FocusRing inherits Rectangle {
    in property <bool> shown;
    in property <length> radius;
    in property <bool> inset;
    width: 100%;
    height: 100%;
    visible: shown;
    Rectangle {
        x: root.inset ? 0px : -3px;
        y: root.inset ? 0px : -3px;
        width: parent.width + (root.inset ? 0px : 6px);
        height: parent.height + (root.inset ? 0px : 6px);
        border-radius: root.inset ? root.radius : root.radius + 3px;
        border-width: 2px;
        border-color: Theme.accent;
    }
}

// What a focusable control does with the focus: Enter activates it (Space stays play /
// pause, the app-wide shortcut), and the page scrolls to show it when it came by Tab.
// It lies under the control's TouchArea, so the pointer works as before.
export component FocusTarget inherits FocusScope {
    in property <string> zone;
    callback activated();
    width: 100%;
    height: 100%;
    focus-on-click: false;
    key-pressed(ev) => {
        if ev.text == Key.Return && !ev.modifiers.control && !ev.modifiers.alt {
            root.activated();
            return accept;
        }
        reject
    }
    focus-gained(reason) => {
        Focus.zone = root.zone;
        if reason == FocusReason.tab-navigation && root.zone == "" {
            Actions.reveal(self.absolute-position.y, self.height);
        }
    }
    focus-lost => {
        if Focus.zone == root.zone { Focus.zone = ""; }
    }
}

export component Icon inherits Path {
    in property <string> glyph;
    in property <color> color: Theme.text;
    commands: glyph;
    fill: color;
    viewbox-width: 24;
    viewbox-height: 24;
    width: 20px;
    height: 20px;
}

// A tooltip's look (inside Slint's `Tooltip`, which shows it after a short hover and takes no
// input: what is under it keeps its clicks).
export component TipBubble inherits Rectangle {
    in property <string> text;
    width: tip.preferred-width + 20px;
    height: 28px;
    border-radius: 6px;
    background: Theme.surface-hi;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 12px;
    drop-shadow-color: #00000080;
    tip := Text {
        text: root.text;
        font-size: Theme.font-small;
        color: Theme.text;
    }
}

export component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <length> size: 36px;
    in property <length> icon-size: 20px;
    in property <bool> active;
    in property <bool> primary;
    // Shown in the app's style after a short hover.
    in property <string> tooltip;
    in property <bool> enabled: true;
    // A destructive action armed (second click to confirm): drawn in red.
    in property <bool> danger;
    // What a screen reader says (icon-only buttons have no text); the tooltip if empty.
    in property <string> label;
    // Reached with Tab. Off for buttons that only show on hover (a row's actions: the
    // row's list takes the keys and the menu instead).
    in property <bool> tabbable: true;
    in property <string> zone;
    callback clicked();
    width: size;
    height: size;
    border-radius: self.width / 2;
    accessible-role: button;
    accessible-label: root.label != "" ? root.label : root.tooltip;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    fs := FocusTarget {
        enabled: root.enabled && root.tabbable;
        zone: root.zone;
        activated => { root.clicked(); }
    }
    background: primary ? (ta.pressed ? Theme.accent.darker(15%) : ta.has-hover ? Theme.accent.brighter(8%) : Theme.accent)
        : ta.pressed ? Theme.press : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.dur-hover; }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    out property <bool> has-hover: ta.has-hover;
    // Held down (the Lyrics tab's timing buttons repeat while it is).
    out property <bool> pressed: ta.pressed;
    Icon {
        glyph: root.glyph;
        width: root.icon-size;
        height: root.icon-size;
        color: !root.enabled ? Theme.text-faint.with-alpha(0.5)
            : root.danger ? #ff8a80
            : root.primary ? Theme.accent-text : root.active ? Theme.accent : ta.has-hover || fs.has-focus ? Theme.text : Theme.text-dim;
    }
    FocusRing { shown: fs.has-focus; radius: root.width / 2; }
    if root.tooltip != "": Tooltip { TipBubble { text: root.tooltip; } }
}

// What plays from the server (a track only it has, an album with no file here): a small cloud,
// quiet, after the title. Hovering it names the server (`Server.host`, one for every row). It
// sits in a cell of its own width and the row's height, centred, so the row keeps its height,
// and it takes no click (the tooltip only watches the pointer): the row under it keeps them.
export component RemoteMark inherits Rectangle {
    in property <length> size: 14px;
    in property <color> tint: Theme.text-faint;
    width: root.size;
    horizontal-stretch: 0;
    accessible-role: none;
    mark := Rectangle {
        y: (parent.height - self.height) / 2;
        width: root.size;
        height: root.size;
        Icon { glyph: Icons.cloud; width: root.size; height: root.size; color: root.tint; }
        if Server.host != "": Tooltip { TipBubble { text: Server.host; } }
    }
}

export component TextButton inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <bool> primary;
    // What a screen reader says, when the text alone does not say it.
    in property <string> label;
    in property <bool> tabbable: true;
    in property <string> zone;
    callback clicked();
    // For a dialog that moves the focus itself (dialogs.slint).
    public function focus-button() { fs.focus(); }
    out property <bool> focused: fs.has-focus;
    height: 36px;
    min-width: lay.preferred-width;
    border-radius: Theme.radius-pill;
    accessible-role: button;
    accessible-label: root.label != "" ? root.label : root.text;
    accessible-action-default => { root.clicked(); }
    fs := FocusTarget {
        enabled: root.tabbable;
        zone: root.zone;
        activated => { root.clicked(); }
    }
    background: primary ? (ta.has-hover ? Theme.accent.brighter(8%) : Theme.accent) : (ta.has-hover ? Theme.surface-hi : Theme.surface);
    border-width: primary ? 0 : 1px;
    border-color: Theme.border;
    animate background { duration: Theme.dur-hover; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    lay := HorizontalLayout {
        padding-left: 16px;
        padding-right: 18px;
        spacing: 6px;
        alignment: center;
        if root.glyph != "": Icon {
            y: (parent.height - self.height) / 2;
            glyph: root.glyph;
            width: 18px;
            height: 18px;
            color: root.primary ? Theme.accent-text : Theme.text;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Theme.font-body;
            font-weight: 600;
            color: root.primary ? Theme.accent-text : Theme.text;
            accessible-role: none;
        }
    }
    FocusRing { shown: fs.has-focus; radius: root.height / 2; }
}

// Text that navigates somewhere: pointer cursor and accent colour on hover, like a link.
export component LinkText inherits Text {
    in property <color> base-color: Theme.text-dim;
    // Reached with Tab; off inside lists (the list's cursor stands for the row).
    in property <bool> tabbable;
    in property <string> zone;
    callback clicked();
    // A right click on the link: the row it sits in shows its menu (window coordinates).
    callback context-requested(length, length);
    color: lta.has-hover || fs.has-focus ? Theme.accent : base-color;
    overflow: elide;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    fs := FocusTarget {
        enabled: root.tabbable;
        zone: root.zone;
        activated => { root.clicked(); }
    }
    FocusRing { shown: fs.has-focus; radius: 4px; }
    lta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(ev) => {
            if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down {
                root.context-requested(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// An artist credit as shown ("A feat. B", "Mara Lind; Kenji Arai"), each credited artist's
// name a link to their page and the rest plain text (`Actions.artist-links`). `kind` and
// `ref-id` say whose credit it is: a "track" or an "album" of the library, by id.
export component ArtistLinks inherits HorizontalLayout {
    in property <string> text;
    in property <string> kind: "track";
    in property <int> ref-id;
    in property <length> font-size: Theme.font-small;
    in property <color> base-color: Theme.text-dim;
    in property <int> font-weight: 400;
    in property <bool> tabbable;
    in property <string> zone;
    callback context-requested(length, length);
    private property <[ArtistLink]> parts: Actions.artist-links(kind, ref-id, text);
    alignment: start;
    for part in parts: HorizontalLayout {
        if part.key != "": LinkText {
            text: part.text;
            font-size: root.font-size;
            font-weight: root.font-weight;
            base-color: root.base-color;
            tabbable: root.tabbable;
            zone: root.zone;
            clicked => { Actions.open-artist(part.key); }
            context-requested(x, y) => { root.context-requested(x, y); }
        }
        if part.key == "": Text {
            accessible-role: none;
            text: part.text;
            font-size: root.font-size;
            font-weight: root.font-weight;
            color: root.base-color;
            overflow: elide;
        }
    }
}

// Square album art with rounded corners; a tinted placeholder when there is none.
export component Cover inherits Rectangle {
    in property <image> source;
    in property <bool> has-cover: true;
    in property <color> tint: Theme.surface-hi;
    in property <length> size: 120px;
    in property <length> radius: Theme.radius-cover;
    // Album title, set on the placeholder when there is no art (large covers only).
    in property <string> label;
    width: size;
    height: size;
    border-radius: radius;
    clip: true;
    // No art: a sleeve in the album's tint, lit from the top left, with its title.
    background: has-cover ? Theme.surface : @linear-gradient(135deg, tint.brighter(35%) 0%, tint 55%, tint.darker(45%) 100%);
    if !root.has-cover && (root.label == "" || root.size < 120px): Icon {
        glyph: Icons.note;
        width: root.size * 0.3;
        height: root.size * 0.3;
        color: #ffffff38;
    }
    if !root.has-cover && root.label != "" && root.size >= 120px: Rectangle {
        Icon {
            x: root.size * 0.09;
            y: root.size * 0.09;
            glyph: Icons.note;
            width: root.size * 0.12;
            height: root.size * 0.12;
            color: #ffffff40;
        }
        Text {
            x: root.size * 0.09;
            width: root.size * 0.82;
            y: root.size - self.height - root.size * 0.09;
            height: min(self.preferred-height, root.size * 0.6);
            text: root.label;
            wrap: word-wrap;
            overflow: elide;
            font-size: max(12px, root.size * 0.085);
            font-weight: 800;
            color: #ffffffd8;
            vertical-alignment: bottom;
        }
    }
    Image {
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: cover;
        image-rendering: smooth;
    }
}

// A cover with title and artist under it, play button on hover. As a browse tile
// (`group`: an artist, a genre, a label), the second line is plain text ("12 albums"),
// with no play button and no album menu; `round` for an artist.
export component AlbumTile inherits Rectangle {
    in property <AlbumCard> album;
    in property <length> size: Theme.cover-size;
    // The keyboard cursor of the tile's list is here (the list has the focus).
    in property <bool> focused;
    // Place in its list, for screen readers.
    in property <int> index;
    in property <bool> group;
    in property <bool> round;
    callback open();
    callback play();
    callback open-artist();
    width: size;
    height: cover.height + 50px;
    accessible-role: list-item;
    accessible-label: root.album.title + ", " + root.album.artist + (root.album.year != "" ? ", " + root.album.year : "") + (root.album.remote ? ", from the server" : "");
    accessible-item-index: root.index;
    accessible-action-default => { root.open(); }
    function menu-at(x: length, y: length) {
        if !root.group {
            Actions.menu-request("album", "", 0, root.album.id, x, y);
        }
    }
    cover := Cover {
        y: ta.has-hover || play-ta.has-hover || root.focused ? -3px : 0px;
        radius: root.round ? root.size / 2 : Theme.radius-cover;
        animate y { duration: Theme.dur-hover; easing: ease-out; }
        size: root.size;
        source: root.album.cover;
        has-cover: root.album.has-cover;
        tint: root.album.tint;
        // A round placeholder has no room for the name (it is under the tile anyway).
        label: root.round ? "" : root.album.title;
        drop-shadow-blur: ta.has-hover ? 18px : 8px;
        drop-shadow-color: #00000080;
        drop-shadow-offset-y: 4px;
        // Drag the cover onto the queue to add the album there.
        DragArea {
            enabled: !root.group;
            data: Actions.album-payload(root.album.id);
            allow-copy: true;
            drag-image: root.album.cover;
            drag-image-offset-x: -12;
            drag-image-offset-y: -12;
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open(); }
                pointer-event(ev) => {
                    if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down {
                        root.menu-at(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }
        }
        play-ta := TouchArea {
            x: parent.width - self.width - 10px;
            y: parent.height - self.height - 10px;
            width: 44px;
            height: 44px;
            visible: !root.group;
            mouse-cursor: pointer;
            clicked => { root.play(); }
            // Keep the hit area while faded out. A transparent composite would still
            // render its shadow and icon into a Skia layer for every album.
            private property <float> fade: ta.has-hover || self.has-hover || root.focused ? 1 : 0;
            animate fade { duration: Theme.dur-hover; }
            if play-ta.fade > 0: Rectangle {
                border-radius: 22px;
                background: play-ta.has-hover ? Theme.accent.brighter(10%) : Theme.accent;
                opacity: play-ta.fade;
                drop-shadow-blur: 10px;
                drop-shadow-color: #00000080;
                Icon { glyph: Icons.play; width: 24px; height: 24px; color: Theme.accent-text; }
            }
        }
    }
    Rectangle {
        y: cover.y;
        width: root.size;
        height: root.size;
        FocusRing { shown: root.focused; radius: cover.radius; }
    }
    LinkText {
        x: root.round ? (root.width - self.width) / 2 : 0px;
        y: cover.height + 8px;
        width: min(self.preferred-width, root.width);
        text: root.album.title;
        font-size: Theme.font-body;
        font-weight: 600;
        base-color: Theme.text;
        clicked => { root.open(); }
        context-requested(x, y) => { root.menu-at(x, y); }
    }
    if root.group: Text {
        x: 0;
        y: cover.height + 28px;
        width: root.width;
        height: 18px;
        text: root.album.artist;
        horizontal-alignment: root.round ? center : left;
        font-size: Theme.font-small;
        color: Theme.text-dim;
        overflow: elide;
    }
    if !root.group: HorizontalLayout {
        x: 0;
        y: cover.height + 28px;
        width: root.width;
        height: 18px;
        alignment: start;
        ArtistLinks {
            text: root.album.artist;
            kind: "album";
            ref-id: root.album.id;
            context-requested(x, y) => { root.menu-at(x, y); }
        }
        if root.album.year != "": Text {
            text: " · " + root.album.year;
            font-size: Theme.font-small;
            color: Theme.text-faint;
            horizontal-stretch: 0;
        }
        if root.album.remote: Rectangle { width: 6px; horizontal-stretch: 0; }
        if root.album.remote: RemoteMark { size: 13px; }
    }
}

// A thin progress/volume slider. `value` 0..1, reports drags through `changed`.
// A horizontal slider. While dragging it shows the pointer's position; after release it
// keeps showing that target until `value` arrives within `settle` of it (or 1.5 s pass),
// so a seek bar never jumps back to the old position while the seek lands.
export component Slider inherits Rectangle {
    // Only the idle seek fill can be presented separately on macOS.
    in property <bool> external-fill;
    out property <bool> resting: !ta.has-hover && !fs.has-focus && !root.active;
    private property <length> filled-width: rail.width * clamp(root.shown, 0, 1);
    out property <StageBounds> fill-frame: {
        x: rail.absolute-position.x, y: rail.absolute-position.y,
        width: root.filled-width, height: rail.height,
    };
    in property <float> value;
    in property <bool> enabled: true;
    // How close `value` must come to the released target to count as arrived.
    in property <float> settle: 0.002;
    // Keyboard: the arrow keys move it by `step` (Page Up/Down by four steps, Home/End to
    // the ends) and report the new value through `keyed`.
    in property <float> step: 0.05;
    // The mouse wheel over it moves it a step per notch, up for more, reported through
    // `keyed` (the volume). Off by default: a wheel passing over a seek bar must not seek.
    in property <bool> wheel: false;
    // What a screen reader says: what it sets, and the value as text.
    in property <string> label;
    in property <string> value-text;
    in property <string> zone;
    callback changed(float);
    callback released(float);
    callback keyed(float);
    height: 16px;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value-text;
    accessible-value-minimum: 0;
    accessible-value-maximum: 1;
    accessible-value-step: root.step;
    accessible-enabled: root.enabled;
    accessible-action-increment => { root.key-step(1); }
    accessible-action-decrement => { root.key-step(-1); }
    function key-step(steps: float) {
        root.key-to(root.shown + steps * root.step);
    }
    function key-to(v: float) {
        root.hold = clamp(v, 0, 1);
        root.keyed(root.hold);
    }
    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(ev) => {
            if ev.modifiers.control || ev.modifiers.alt || ev.modifiers.shift { return reject; }
            if ev.text == Key.RightArrow || ev.text == Key.UpArrow { root.key-step(1); return accept; }
            if ev.text == Key.LeftArrow || ev.text == Key.DownArrow { root.key-step(-1); return accept; }
            if ev.text == Key.PageUp { root.key-step(4); return accept; }
            if ev.text == Key.PageDown { root.key-step(-4); return accept; }
            if ev.text == Key.Home { root.key-to(0); return accept; }
            if ev.text == Key.End { root.key-to(1); return accept; }
            reject
        }
        focus-gained => { Focus.zone = root.zone; }
        focus-lost => {
            if Focus.zone == root.zone { Focus.zone = ""; }
        }
    }
    private property <float> drag-value;
    private property <float> hold: -1;
    private property <float> shown: ta.pressed ? drag-value : hold >= 0 ? hold : value;
    // What the slider shows, and whether that is the user's target rather than `value`.
    out property <float> shown-value: shown;
    out property <bool> active: ta.pressed || hold >= 0;
    changed value => {
        if hold >= 0 && abs(value - hold) <= settle { hold = -1; }
    }
    Timer {
        interval: 1500ms;
        running: root.hold >= 0 && !ta.pressed;
        triggered => { root.hold = -1; }
    }
    rail := Rectangle {
        y: (parent.height - self.height) / 2;
        height: ta.has-hover || ta.pressed ? 6px : 4px;
        animate height { duration: Theme.dur-hover; }
        border-radius: self.height / 2;
        background: #ffffff26;
        Rectangle {
            x: 0;
            width: root.external-fill ? 0px : root.filled-width;
            height: parent.height;
            border-radius: parent.border-radius;
            background: ta.has-hover || ta.pressed ? Theme.accent : Theme.text;
        }
    }
    Rectangle {
        x: root.external-fill ? 0px : root.width * clamp(root.shown, 0, 1) - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.text;
        visible: root.enabled && (ta.has-hover || ta.pressed || fs.has-focus);
    }
    FocusRing { shown: fs.has-focus; radius: root.height / 2; }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down {
                root.drag-value = clamp(self.mouse-x / root.width, 0, 1);
                root.changed(root.drag-value);
            }
            if ev.kind == PointerEventKind.up {
                root.hold = root.drag-value;
                root.released(root.drag-value);
            }
        }
        moved => {
            if self.pressed {
                root.drag-value = clamp(self.mouse-x / root.width, 0, 1);
                root.changed(root.drag-value);
            }
        }
        scroll-event(ev) => {
            if !root.wheel || self.pressed { return reject; }
            // A touchpad's sideways swipe counts too (right for more).
            if ev.delta-y != 0 || ev.delta-x != 0 {
                root.key-step(ev.delta-y > 0 || (ev.delta-y == 0 && ev.delta-x < 0) ? 1 : -1);
            }
            accept
        }
    }
}

export component SectionTitle inherits Text {
    font-size: Theme.font-heading;
    font-weight: 700;
    color: Theme.text;
}

// A row's background: chosen in the list's selection (accent, stronger under the pointer),
// else the hover. Apart from the playing marks (accent text, the play glyph; the queue's
// current row a fainter accent).
export global RowLook {
    public pure function background(selected: bool, hover: bool) -> color {
        return selected ? Theme.accent.with-alpha(hover ? 0.30 : 0.22) : hover ? Theme.hover : transparent;
    }
}

// One row of a track list. Double-click plays; the trailing buttons act on it. A press
// chooses it (with Ctrl or Shift: toggles it, or the range): the list's selection.
export component TrackListRow inherits Rectangle {
    in property <TrackRow> track;
    in property <bool> show-cover;
    in property <bool> show-album;
    // The list has a technical details column (Settings > Window > Show technical
    // details). Drawn only where the row is wide enough to keep the title its room.
    in property <bool> details-column;
    // (By the page's width: the row's own would depend on the column itself.)
    private property <bool> show-details: root.details-column && Player.show-details && Nav.content-width - 2 * Theme.page-margin >= 720px;
    callback play();
    callback enqueue(bool);
    callback favourite();
    callback open-album();
    callback open-artist();
    callback add-to-playlist(int);
    // The left button down on the row (Ctrl, Shift), and that press ended as a click.
    callback select-press(bool, bool);
    callback select-release();
    // Set by the list: what the row's drag payload names.
    in property <string> ctx;
    // The keyboard cursor of the row's list is here (the list has the focus).
    in property <bool> focused;
    out property <bool> hovered: ta.has-hover;
    private property <bool> show-actions: ta.has-hover || root.focused;
    accessible-role: list-item;
    accessible-label: root.track.title + ", " + root.track.artist + (root.show-album ? ", " + root.track.album : "") + ", " + root.track.duration
        + (root.show-details && root.track.details != "" ? ", " + root.track.details : "") + (root.track.remote ? ", from the server" : "");
    accessible-item-index: root.index;
    accessible-item-selectable: true;
    accessible-item-selected: root.track.selected;
    accessible-action-default => { root.play(); }
    function menu-at(x: length, y: length) {
        Actions.menu-request("track", root.ctx, root.index, root.track.id, x, y);
    }
    in property <int> index;
    height: 52px;
    border-radius: Theme.radius-control;
    background: RowLook.background(root.track.selected, ta.has-hover);
    // Drag the row onto the queue to add the track there (with the rows chosen, when it is one).
    DragArea {
        enabled: root.ctx != "";
        // The track's id too: the drop finds it again if the list changed meanwhile.
        data: Actions.track-payload(root.ctx, root.index, root.track.id);
        allow-copy: true;
        ta := TouchArea {
            double-clicked => { root.play(); }
            clicked => { root.select-release(); }
            pointer-event(ev) => {
                if ev.button == PointerEventButton.left && ev.kind == PointerEventKind.down {
                    root.select-press(ev.modifiers.control, ev.modifiers.shift);
                }
                if ev.button == PointerEventButton.right && ev.kind == PointerEventKind.down {
                    root.menu-at(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
    // The row's content is inside its TouchArea: a TouchArea keeps its hover while a child of
    // it has the pointer, but loses it to one drawn over it beside it. With the content a
    // sibling, the play button (shown while the row is hovered) took the pointer, the row lost
    // its hover, the button went, the row had it again: a flip on every pointer move, the row
    // blinking and the click landing on whichever was there. The row's own buttons hid as
    // they were hovered, for the same reason.
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 14px;
        Rectangle {
            width: root.show-cover ? 36px : 28px;
            if root.show-cover: Cover {
                y: (parent.height - self.height) / 2;
                size: 36px;
                radius: 4px;
                source: root.track.cover;
            }
            if !root.show-cover && !root.track.playing && !ta.has-hover: Text {
                text: root.track.number;
                horizontal-alignment: right;
                vertical-alignment: center;
                width: 100%;
                height: 100%;
                font-size: Theme.font-body;
                color: Theme.text-faint;
            }
            if !root.show-cover && (root.track.playing || ta.has-hover): Rectangle {
                Icon {
                    x: parent.width - self.width;
                    y: (parent.height - self.height) / 2;
                    glyph: Icons.play;
                    width: 18px;
                    height: 18px;
                    color: root.track.playing ? Theme.accent : Theme.text;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.play(); }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                alignment: start;
                spacing: 6px;
                Text {
                    text: root.track.title;
                    overflow: elide;
                    font-size: Theme.font-body;
                    font-weight: 500;
                    color: root.track.playing ? Theme.accent : Theme.text;
                }
                if root.track.remote: RemoteMark { }
            }
            HorizontalLayout {
                alignment: start;
                ArtistLinks {
                    text: root.track.artist;
                    ref-id: root.track.id;
                    context-requested(x, y) => { root.menu-at(x, y); }
                }
                if root.show-album: Text { text: " · "; font-size: Theme.font-small; color: Theme.text-faint; horizontal-stretch: 0; }
                if root.show-album: LinkText {
                    text: root.track.album;
                    font-size: Theme.font-small;
                    clicked => { root.open-album(); }
                    context-requested(x, y) => { root.menu-at(x, y); }
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 2px;
            IconButton { y: 8px; glyph: root.show-actions ? Icons.queue : ""; size: 32px; icon-size: 18px; label: "Add to queue"; tabbable: false; clicked => { root.enqueue(false); } }
            IconButton { y: 8px; glyph: root.show-actions ? Icons.plus : ""; size: 32px; icon-size: 18px; label: "Play next"; tabbable: false; clicked => { root.enqueue(true); } }
        }
        // Technical details: quiet, right-aligned, one width for every row so they line up.
        if root.show-details: Text {
            width: 84px;
            text: root.track.details;
            horizontal-alignment: right;
            vertical-alignment: center;
            font-size: Theme.font-small;
            color: Theme.text-faint;
            overflow: elide;
            accessible-role: none;
        }
        IconButton {
            y: 8px;
            glyph: root.track.favourite ? Icons.heart : root.show-actions ? Icons.heart-outline : "";
            size: 32px;
            icon-size: 18px;
            active: root.track.favourite;
            label: root.track.favourite ? "Remove from favourites" : "Add to favourites";
            tabbable: false;
            clicked => { root.favourite(); }
        }
        Text {
            width: 48px;
            text: root.track.duration;
            horizontal-alignment: right;
            vertical-alignment: center;
            font-size: Theme.font-small;
            color: Theme.text-dim;
        }
    }
        }
    }
    FocusRing { shown: root.focused; radius: Theme.radius-control; inset: true; }
}

// Holds a text field's keys: what the field does not take stops here, so no shortcut
// fires while typing (Space types a space, M an m). Only Tab and Shift+Tab (to the next
// control) and Esc go on. (Alt+Left / Alt+Right, back and forward, the fields send on
// themselves: a TextInput takes the arrows before they could get here.)
component TypingScope inherits FocusScope {
    focus-on-click: false;
    focus-on-tab-navigation: false;
    key-pressed(ev) => {
        if ev.text == Key.Tab || ev.text == Key.Backtab || ev.text == Key.Escape { return reject; }
        accept
    }
    focus-gained => { Focus.zone = ""; }
}

export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "Search";
    callback edited(string);
    callback accepted(string);
    callback escape();
    public function focus-field() { input.focus(); input.select-all(); }
    height: 44px;
    border-radius: Theme.radius-pill;
    background: Theme.surface;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;
        Icon { y: (parent.height - self.height) / 2; glyph: Icons.search; color: Theme.text-dim; }
        Rectangle {
            Text {
                width: 100%;
                height: 100%;
                text: root.placeholder;
                vertical-alignment: center;
                color: Theme.text-faint;
                font-size: Theme.font-title;
                visible: input.text == "";
            }
            TypingScope {
                input := TextInput {
                    width: 100%;
                    height: 100%;
                    text <=> root.text;
                    vertical-alignment: center;
                    color: Theme.text;
                    font-size: Theme.font-title;
                    selection-background-color: Theme.accent.with-alpha(0.4);
                    accessible-label: root.placeholder;
                    edited => { root.edited(self.text); }
                    accepted => { root.accepted(self.text); }
                    key-pressed(ev) => {
                        if ev.text == Key.Escape {
                            root.escape();
                            return accept;
                        }
                        if ev.modifiers.alt && !ev.modifiers.control && (ev.text == Key.LeftArrow || ev.text == Key.RightArrow) {
                            return Actions.shortcut(ev.text, false, ev.modifiers.shift, true) ? accept : reject;
                        }
                        reject
                    }
                }
            }
        }
    }
}

// A simple single-line field for names (playlists, shelf titles).
export component LineField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    // What a screen reader calls the field, when the placeholder does not say it.
    in property <string> label;
    // `password` hides what is typed (a shared secret).
    in property <InputType> input-type: InputType.text;
    callback accepted(string);
    callback edited(string);
    callback escape();
    public function focus-field() { input.focus(); input.select-all(); }
    out property <bool> focused: input.has-focus;
    height: 36px;
    border-radius: Theme.radius-control;
    background: Theme.surface;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    Text {
        x: 12px;
        width: parent.width - 24px;
        height: 100%;
        text: root.placeholder;
        vertical-alignment: center;
        color: Theme.text-faint;
        font-size: Theme.font-body;
        visible: input.text == "";
    }
    TypingScope {
        input := TextInput {
            x: 12px;
            width: parent.width - 24px;
            height: 100%;
            text <=> root.text;
            input-type: root.input-type;
            vertical-alignment: center;
            color: Theme.text;
            font-size: Theme.font-body;
            selection-background-color: Theme.accent.with-alpha(0.4);
            accessible-label: root.label != "" ? root.label : root.placeholder;
            accepted => { root.accepted(self.text); }
            edited => { root.edited(self.text); }
            key-pressed(ev) => {
                if ev.text == Key.Escape {
                    root.escape();
                    return accept;
                }
                if ev.modifiers.alt && !ev.modifiers.control && (ev.text == Key.LeftArrow || ev.text == Key.RightArrow) {
                    return Actions.shortcut(ev.text, false, ev.modifiers.shift, true) ? accept : reject;
                }
                reject
            }
        }
    }
}

// ---- Settings controls ---------------------------------------------------------
//
// Controls that show their state: a switch for on / off, a segmented control for a
// small choice (every option visible, the chosen one filled), a stepper for a number.
// Each is one Tab stop; Enter (or a click) acts, as on every button of the app (Space
// stays play / pause).

// On / off. Accent track with a dark knob at the right when on; a quiet outlined track
// with the knob at the left when off.
export component Switch inherits Rectangle {
    in property <bool> checked;
    // What a screen reader calls it (the setting's name).
    in property <string> label;
    in property <bool> enabled: true;
    in property <string> zone;
    // The row around it is hovered (the whole row toggles it).
    in property <bool> hovered;
    callback toggled();
    width: 44px;
    height: 24px;
    border-radius: self.height / 2;
    background: root.checked ? (ta.has-hover || root.hovered ? Theme.accent.brighter(8%) : Theme.accent)
        : ta.has-hover || root.hovered ? Theme.press : Theme.hover;
    border-width: root.checked ? 0px : 1px;
    border-color: Theme.text-faint.with-alpha(0.55);
    opacity: root.enabled ? 1 : 0.45;
    animate background { duration: Theme.dur-hover; }
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.toggled(); } }
    fs := FocusTarget {
        enabled: root.enabled;
        zone: root.zone;
        activated => { root.toggled(); }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
    Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.checked ? Theme.accent-text : Theme.text-dim;
        animate x { duration: Theme.dur-hover; easing: ease-out; }
    }
    FocusRing { shown: fs.has-focus; radius: root.height / 2; }
}

// A small choice: the options side by side in a pill, the chosen one filled with the
// accent. One Tab stop: Left / Right (or Up / Down, Home / End) choose the neighbour at
// once, like radio buttons; a click chooses that option.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    // What a screen reader calls the group (the setting's name).
    in property <string> label;
    in property <string> zone;
    callback chosen(int);
    height: 32px;
    width: lay.preferred-width;
    border-radius: self.height / 2;
    background: Theme.hover;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: radio-group;
    accessible-label: root.label;
    accessible-value: root.selected >= 0 && root.selected < root.options.length ? root.options[root.selected] : "";
    accessible-description: "Left and Right choose";
    accessible-action-increment => { root.pick(root.selected + 1); }
    accessible-action-decrement => { root.pick(root.selected - 1); }
    function pick(i: int) {
        if i >= 0 && i < root.options.length && i != root.selected { root.chosen(i); }
    }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(ev) => {
            if ev.modifiers.control || ev.modifiers.alt || ev.modifiers.shift { return reject; }
            if ev.text == Key.RightArrow || ev.text == Key.DownArrow { root.pick(root.selected + 1); return accept; }
            if ev.text == Key.LeftArrow || ev.text == Key.UpArrow { root.pick(root.selected - 1); return accept; }
            if ev.text == Key.Home { root.pick(0); return accept; }
            if ev.text == Key.End { root.pick(root.options.length - 1); return accept; }
            reject
        }
        focus-gained(reason) => {
            Focus.zone = root.zone;
            if reason == FocusReason.tab-navigation && root.zone == "" {
                Actions.reveal(self.absolute-position.y, self.height);
            }
        }
        focus-lost => {
            if Focus.zone == root.zone { Focus.zone = ""; }
        }
    }
    lay := HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for o[i] in root.options: Rectangle {
            property <bool> on: i == root.selected;
            min-width: t.preferred-width + 28px;
            border-radius: self.height / 2;
            background: self.on ? Theme.accent : sta.has-hover ? Theme.hover : transparent;
            animate background { duration: Theme.dur-hover; }
            accessible-role: radio-button;
            accessible-label: o;
            accessible-checkable: true;
            accessible-checked: self.on;
            accessible-action-default => { root.pick(i); }
            sta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.pick(i); }
            }
            t := Text {
                text: o;
                font-size: Theme.font-small;
                font-weight: parent.on ? 700 : 500;
                color: parent.on ? Theme.accent-text : sta.has-hover ? Theme.text : Theme.text-dim;
                accessible-role: none;
            }
        }
    }
    FocusRing { shown: fs.has-focus; radius: root.height / 2; }
}

// A number stepped down and up: − value +. One Tab stop; the arrows step it (Up / Right
// up, Down / Left down).
export component Stepper inherits Rectangle {
    in property <string> value;
    in property <string> label;
    in property <string> zone;
    // The value's room, so the buttons stay put as it changes.
    in property <length> value-width: 64px;
    callback step(int);
    height: 32px;
    width: lay.preferred-width;
    border-radius: self.height / 2;
    background: Theme.hover;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: spinbox;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-action-increment => { root.step(1); }
    accessible-action-decrement => { root.step(-1); }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(ev) => {
            if ev.modifiers.control || ev.modifiers.alt || ev.modifiers.shift { return reject; }
            if ev.text == Key.UpArrow || ev.text == Key.RightArrow { root.step(1); return accept; }
            if ev.text == Key.DownArrow || ev.text == Key.LeftArrow { root.step(-1); return accept; }
            reject
        }
        focus-gained(reason) => {
            Focus.zone = root.zone;
            if reason == FocusReason.tab-navigation && root.zone == "" {
                Actions.reveal(self.absolute-position.y, self.height);
            }
        }
        focus-lost => {
            if Focus.zone == root.zone { Focus.zone = ""; }
        }
    }
    lay := HorizontalLayout {
        padding: 2px;
        IconButton { glyph: Icons.minus; size: 28px; icon-size: 16px; tabbable: false; label: root.label + " down"; clicked => { root.step(-1); } }
        Text {
            width: root.value-width;
            text: root.value;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: Theme.font-body;
            font-weight: 600;
            color: Theme.text;
            accessible-role: none;
        }
        IconButton { glyph: Icons.plus; size: 28px; icon-size: 16px; tabbable: false; label: root.label + " up"; clicked => { root.step(1); } }
    }
    FocusRing { shown: fs.has-focus; radius: root.height / 2; }
}

// The hairline between a card's rows (and under its heading), inset like the rows.
export component Hairline inherits Rectangle {
    height: 1px;
    Rectangle {
        x: 20px;
        width: parent.width - 40px;
        height: 1px;
        background: Theme.border;
    }
}

// A group of related settings: a rounded card with its heading (and an optional quiet
// line under it), the rows below, divided by hairlines.
export component SettingCard inherits Rectangle {
    in property <string> title;
    in property <string> note;
    height: lay.preferred-height;
    border-radius: Theme.radius-card;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: groupbox;
    accessible-label: root.title;
    lay := VerticalLayout {
        padding-bottom: 2px;
        if root.title != "": VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 16px;
            padding-bottom: 12px;
            spacing: 3px;
            Text {
                text: root.title;
                font-size: Theme.font-title;
                font-weight: 700;
                color: Theme.text;
                accessible-role: none;
            }
            if root.note != "": Text { text: root.note; font-size: Theme.font-small; color: Theme.text-faint; wrap: word-wrap; }
        }
        @children
    }
}

// One setting in a card: its name, a short quiet line under it saying what it does, and
// its control at the row's right edge. `more`, when set, is the longer explanation behind
// a "More" disclosure. A row the filter box jumped to (SettingsView.highlight) scrolls
// into view and is outlined for a moment.
export component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <string> more;
    // The name "Find a setting" knows the row by, when the label carries a value too
    // ("Version 2026.11.15.3"); empty: the label.
    in property <string> find-key;
    // A hairline above the row.
    in property <bool> divider: true;
    // The whole row toggles (a switch's row): hover shows, a click anywhere toggles.
    in property <bool> clickable;
    out property <bool> hovered: rta.has-hover;
    callback clicked();
    private property <bool> expanded;
    private property <bool> lit: root.label != "" && SettingsView.highlight == (root.find-key != "" ? root.find-key : root.label);
    private property <bool> revealed;
    changed lit => {
        if !self.lit { self.revealed = false; }
    }
    // Scroll to the row once it is laid out, when the filter jumped to it.
    Timer {
        interval: 80ms;
        running: root.lit && !root.revealed;
        triggered => {
            root.revealed = true;
            Actions.reveal(root.absolute-position.y, root.height);
        }
    }
    if root.divider: Hairline { y: 0; width: parent.width; }
    Rectangle {
        x: 6px;
        y: 4px;
        width: parent.width - 12px;
        height: parent.height - 8px;
        border-radius: Theme.radius-control;
        background: root.clickable && rta.has-hover ? Theme.hover : transparent;
        border-width: root.lit ? 2px : 0px;
        border-color: Theme.accent;
    }
    rta := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { root.clicked(); }
    }
    height: lay.preferred-height;
    lay := HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 24px;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                font-size: Theme.font-body;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
            }
            if root.hint != "": Text { text: root.hint; font-size: Theme.font-small; color: Theme.text-faint; wrap: word-wrap; }
            if root.more != "": HorizontalLayout {
                alignment: start;
                LinkText {
                    text: root.expanded ? "Less" : "More";
                    font-size: Theme.font-small;
                    base-color: Theme.text-dim;
                    tabbable: true;
                    accessible-label: (root.expanded ? "Less about " : "More about ") + root.label;
                    accessible-expandable: true;
                    accessible-expanded: root.expanded;
                    clicked => { root.expanded = !root.expanded; }
                }
            }
            if root.more != "" && root.expanded: Text { text: root.more; font-size: Theme.font-small; color: Theme.text-dim; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            @children
        }
    }
}

// A switch's row: the name, the hint, the switch; a click anywhere on the row toggles.
export component SwitchRow inherits SettingRow {
    in property <bool> checked;
    // Off: shown dimmed, and neither the row nor the switch toggles.
    in property <bool> enabled: true;
    callback toggled();
    clickable: root.enabled;
    clicked => { root.toggled(); }
    Switch {
        checked: root.checked;
        label: root.label;
        enabled: root.enabled;
        hovered: root.hovered;
        toggled => { root.toggled(); }
    }
}

// How far something is (a scan), a thin line in the accent. `value` 0..1.
export component ProgressLine inherits Rectangle {
    in property <float> value;
    in property <string> label;
    height: 4px;
    border-radius: 2px;
    background: Theme.surface-hi;
    accessible-role: progress-indicator;
    accessible-label: root.label;
    accessible-value: round(clamp(root.value, 0, 1) * 100) + "%";
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 1);
        border-radius: 2px;
        background: Theme.accent;
        animate width { duration: 400ms; }
    }
}

// What a section's state is (scanning, connected as, playing on), at its top; actions
// go beside it. `attention` draws it in the accent, for something the user should act on.
export component StatusNote inherits Rectangle {
    in property <string> glyph: Icons.info;
    in property <string> title;
    in property <string> text;
    // A quieter line under the text (Output: what reaches the device); "" for none.
    in property <string> detail;
    // How far, 0..1, as a line under the text (a scan); below 0 for none.
    in property <float> progress: -1;
    in property <bool> attention;
    height: lay.preferred-height;
    border-radius: Theme.radius-card;
    background: root.attention ? Theme.accent.with-alpha(0.12) : Theme.surface;
    border-width: 1px;
    border-color: root.attention ? Theme.accent.with-alpha(0.55) : Theme.border;
    accessible-role: groupbox;
    accessible-label: root.title + (root.title != "" && root.text != "" ? ": " : "") + root.text + (root.detail != "" ? ". " + root.detail : "");
    lay := HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 14px;
        VerticalLayout {
            alignment: start;
            Icon { glyph: root.glyph; width: 20px; height: 20px; color: root.attention ? Theme.accent : Theme.text-dim; }
        }
        VerticalLayout {
            alignment: start;
            spacing: 3px;
            horizontal-stretch: 1;
            if root.title != "": Text { text: root.title; font-size: Theme.font-body; font-weight: 600; color: Theme.text; wrap: word-wrap; accessible-role: none; }
            if root.text != "": Text { text: root.text; font-size: Theme.font-small; color: root.title != "" ? Theme.text-dim : Theme.text; wrap: word-wrap; accessible-role: none; }
            if root.detail != "": Text { text: root.detail; font-size: Theme.font-small; color: Theme.text-faint; wrap: word-wrap; accessible-role: none; }
            if root.progress >= 0: VerticalLayout {
                padding-top: 6px;
                ProgressLine { value: root.progress; label: root.title; }
            }
            // Its actions, under the text.
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                padding-top: 7px;
                @children
            }
        }
    }
}
